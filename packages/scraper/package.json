{
  "name": "@leadhunter/scraper",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/config && cp -R config/. dist/config/ 2>/dev/null || cp -R ../config/. dist/config/ 2>/dev/null || true",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/dedupe.test.ts src/normalizer.test.ts src/providers/provider-interface.test.ts"
  },
  "dependencies": {
    "@leadhunter/shared": "*",
    "axios": "^1.10.0",
    "cheerio": "^1.1.0",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
