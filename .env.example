# Database
DATABASE_URL=postgresql://leadhunter:leadhunter@127.0.0.1:5433/leadhunter?schema=public

# Redis (BullMQ job queue — optional; without it jobs run in-process)
REDIS_URL=redis://127.0.0.1:6379

# Google Places / Maps (recommended for primary discovery at scale)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional licensed Central Registry dataset (JSON or JSONL)
CENTRAL_REGISTRY_DATASET_PATH=

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
API_KEY=
# Relative paths resolve from monorepo root (not process cwd)
STORAGE_ROOT=./storage
AUDIT_LIGHTWEIGHT=false
AUDIT_CONCURRENCY=2
SCRAPE_CONCURRENCY=1
# OpenAI (optional — AI audits and richer outreach emails)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# SMTP — send outreach emails from LeadHunter as your company address
# Example for Google Workspace / Gmail custom domain (info@yourcompany.com):
#   1. Enable 2FA on the Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Fill the values below, then restart the API
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@yourcompany.com
SMTP_PASS=
SMTP_FROM=info@yourcompany.com
SMTP_FROM_NAME=Your Company
SENDER_COMPANY=Your Company

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
