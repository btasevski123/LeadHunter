# Database
DATABASE_URL=postgresql://leadhunter:leadhunter@127.0.0.1:5433/leadhunter?schema=public

# Redis (BullMQ job queue — optional; without it jobs run in-process)
REDIS_URL=redis://127.0.0.1:6379

# Google Places / Maps (recommended for primary discovery at scale)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional licensed Central Registry dataset (JSON or JSONL)
CENTRAL_REGISTRY_DATASET_PATH=

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
API_KEY=
# Relative paths resolve from monorepo root (not process cwd)
STORAGE_ROOT=./storage
AUDIT_LIGHTWEIGHT=false
AUDIT_CONCURRENCY=2
SCRAPE_CONCURRENCY=1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
